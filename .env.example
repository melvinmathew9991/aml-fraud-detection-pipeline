# Copy to .env for local overrides. .env is gitignored; this file is not.
#
# Only variables the code actually reads are listed. Both have working
# defaults, so an empty .env is a valid configuration -- nothing here is
# required to run the project locally.
#
# Everything else is configured in config.yaml, not the environment:
# paths, CV folds, model hyperparameters, Optuna, review capacity, MLflow
# and the economics assumptions. Secrets do not belong in config.yaml, which
# is why this file exists at all (see ARCHITECTURE.md §9).

# Base URL the Streamlit dashboard uses to reach the FastAPI service.
# Read by dashboard/common.py. Default: http://localhost:8000
# In deployment this points at the Cloud Run URL (Sprint 7).
API_BASE_URL=http://localhost:8000

# Port the API listens on. Read by the container's entrypoint, not by the
# Python code. Cloud Run injects this itself and overrides any value set
# here. Default in the image: 8080. Plain local `uvicorn` uses 8000.
PORT=8080

# ---------------------------------------------------------------------------
# Not yet used -- listed so the shape is known before the sprint that adds it.
# Do NOT fill these in until the corresponding sprint lands; an unused secret
# sitting in a .env is still a secret sitting on disk.
#
# Sprint 10 (persistence, auth):
# DATABASE_URL=postgresql://...        # Neon Postgres connection string
# API_KEY=                             # shared key for the /score endpoints
#
# Sprint 12 (GenAI narratives):
# GEMINI_API_KEY=                      # Gemini Flash free tier
