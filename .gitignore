# Data (large / re-downloadable from Kaggle, not meant to be committed)
data/raw/*.csv
data/raw/*.zip

# DuckDB store (regenerable from data/raw via train_pipeline.py)
data/processed/*.duckdb

# Model artifacts and run metadata (regenerate via training; run-specific)
models/**

# EXCEPT the versioned serving bundle -- this is a committed release
# artifact (~7MB), not a run output. See ARCHITECTURE.md §3. Forgetting
# this negation is the exact defect class the Sprint 1 audit caught
# (evidence cited in docs but never actually tracked).
!model_bundle/

# Logs
reports/*.log

# MLflow local tracking store (regenerable via train_pipeline.py)
mlruns/
mlflow.db

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Secrets and cloud credentials. Nothing matching these has ever been
# committed (verified 2026-08-03 against the full history), and the deploy
# design deliberately avoids service-account JSON by using Workload Identity
# Federation (ARCHITECTURE.md §9). These rules exist so that stays true once
# Sprint 7 introduces GCP and Sprint 10 introduces Neon Postgres and API keys
# -- the point of a secrets rule is to predate the secret, not follow it.
.env
.env.*
!.env.example
*-service-account*.json
*credentials*.json
gha-creds-*.json
*.pem
*.key
!model_bundle/**/*.key

# OS
.DS_Store
Thumbs.db

# Claude Code local state
.claude/
